# ============================================================================
# DeepResearch Docker 部署环境变量模板
#
# 使用步骤：
#   Windows PowerShell:
#       Copy-Item .env.docker.example .env.docker
#   macOS / Linux:
#       cp .env.docker.example .env.docker
#
# 然后编辑 .env.docker 填写密钥，并执行：
#   docker compose --env-file .env.docker up -d --build
# ============================================================================

# ---- 阿里云百炼 DashScope（必填：https://bailian.console.aliyun.com/）----
DASHSCOPE_API_KEY=sk-请填写你的Key

# ---- 博查 Bocha Web Search（可选：https://open.bochaai.com/ 注册获取；不填则网络检索返回空）----
BOCHA_API_KEY=sk-请填写你的Key

# ---- 模型与多租户 ----
MODEL=qwen-plus
TENANT_ID=default_tenant
USER_ID=default_user
THREAD_ID=default
MAX_ITERATIONS=3

# ---- 记忆与检索开关（与文档推荐一致：先用 Postgres，Redis 可跳过）----
ENABLE_MEMORY=true
SHORT_TERM_BACKEND=postgres
LONG_TERM_BACKEND=postgres
LONG_TERM_SCOPE=user
CHECKPOINTER_BACKEND=postgres
ENABLE_MILVUS=true
MEMORY_TOP_K=6
MILVUS_COLLECTION=mult_agent_memory

# ---- 容器网络内的连接串（服务名解析，一般无需修改）----
POSTGRES_DSN=postgresql://deepresearch:deepresearch@postgres:5432/deepresearch
REDIS_URL=redis://:deepresearch@redis:6379/0
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530

# ---- 基础设施账号密码（保持与上方连接串一致；生产环境务必修改）----
POSTGRES_USER=deepresearch
POSTGRES_PASSWORD=deepresearch
POSTGRES_DB=deepresearch
REDIS_PASSWORD=deepresearch
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
