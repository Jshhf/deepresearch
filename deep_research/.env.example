# ============================================================================
# DeepResearch 应用环境变量模板（本地开发用）
# 容器化部署请使用：.env.docker.example -> .env.docker
# ============================================================================

# ---- 阿里云百炼 DashScope（必填）----
DASHSCOPE_API_KEY=

# ---- 博查 Bocha Web Search（可选；不填则网络检索返回空）----
BOCHA_API_KEY=

# ---- 模型与多租户 ----
MODEL=qwen-plus
THREAD_ID=default
USER_ID=default_user
TENANT_ID=default_tenant
MAX_ITERATIONS=3

# ---- 记忆与检索 ----
ENABLE_MEMORY=true
SHORT_TERM_TTL_SECONDS=604800
SHORT_TERM_MAX_MESSAGES=30
SHORT_TERM_SUMMARY_THRESHOLD=20
SHORT_TERM_BACKEND=postgres
LONG_TERM_BACKEND=postgres
LONG_TERM_SCOPE=user
SAVE_CONVERSATION_TASK=false
CHECKPOINTER_BACKEND=auto
ENABLE_MILVUS=true
MEMORY_TOP_K=6

# ---- 连接串（本地开发指向本机；Docker 部署用 .env.docker 里的服务名）----
REDIS_URL=
POSTGRES_DSN=
MILVUS_HOST=
MILVUS_PORT=19530
MILVUS_COLLECTION=mult_agent_memory
NO_COLOR=
WORKSPACE_DIR=/workspace
